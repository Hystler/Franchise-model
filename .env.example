# Prisma + Supabase Postgres
# Use Supabase Transaction Pooler for runtime/serverless connections.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require"

# Use the direct Supabase Postgres connection for Prisma migrations.
DIRECT_URL="postgresql://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

NEXT_PUBLIC_APP_NAME="Franchise Model"

# Not used by the current app because it talks to Postgres through Prisma API routes.
# Add these only if a Supabase JS client is introduced later.
# NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
# SUPABASE_SERVICE_ROLE_KEY="..."
